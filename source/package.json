{
  "name": "bcis-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "corepack pnpm --workspace-concurrency=1 -r --if-present build",
    "check": "corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "dev:api": "corepack pnpm --filter @bcis/api dev",
    "dev:desktop": "corepack pnpm --filter @bcis/desktop dev",
    "db:migrate": "corepack pnpm --filter @bcis/database-tools migrate",
    "db:seed-security": "corepack pnpm --filter @bcis/database-tools seed:security",
    "db:seed-master-data": "corepack pnpm --filter @bcis/database-tools seed:master-data",
    "test": "corepack pnpm --workspace-concurrency=1 -r --if-present test",
    "typecheck": "corepack pnpm --workspace-concurrency=1 -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
