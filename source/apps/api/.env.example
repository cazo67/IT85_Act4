NODE_ENV=development
BCIS_API_HOST=127.0.0.1
BCIS_API_PORT=4100
BCIS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://bcis_app:change-me@127.0.0.1:5432/bcis
BCIS_BACKUP_ROOT=C:\BCIS\backups
BCIS_PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
BCIS_PG_RESTORE_PATH=C:\Program Files\PostgreSQL\16\bin\pg_restore.exe
BCIS_BOOTSTRAP_ADMIN_USERNAME=owner
BCIS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-strong-password
LOG_LEVEL=info
